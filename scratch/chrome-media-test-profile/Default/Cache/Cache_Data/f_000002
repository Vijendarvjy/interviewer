/* ==========================================================================
   KETU - Premium Multi-Step Assessment Design System
   ========================================================================== */
@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Outfit:wght@300;400;500;600;700;800&display=swap');

:root {
  --google-blue: #4285f4;
  --google-red: #ea4335;
  --google-yellow: #fbbc04;
  --google-green: #34a853;
  --bg: #030308;
  --bg-gradient: radial-gradient(circle at 50% 0%, #0d0f26 0%, #030308 70%);
  --surface: rgba(13, 17, 33, 0.7);
  --surface-hover: rgba(22, 28, 54, 0.85);
  --surface-solid: #0b0e1a;
  --border: rgba(99, 102, 241, 0.15);
  --border-focus: rgba(6, 182, 212, 0.6);
  --accent: #6366f1;
  --accent-glow: rgba(99, 102, 241, 0.35);
  --accent-purple: #a855f7;
  --accent-purple-glow: rgba(168, 85, 247, 0.3);
  --cyan: #06b6d4;
  --cyan-glow: rgba(6, 182, 212, 0.3);
  --emerald: #10b981;
  --emerald-glow: rgba(16, 185, 129, 0.25);
  --amber: #f59e0b;
  --rose: #f43f5e;
  --rose-glow: rgba(244, 63, 94, 0.35);
  --text: #f8fafc;
  --text-muted: #94a3b8;
  --text-dark: #475569;
  --radius-lg: 24px;
  --radius-md: 16px;
  --radius-sm: 10px;
  --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

body.theme-light {
  --bg: #ffffff;
  --bg-gradient: linear-gradient(180deg, #ffffff 0%, #ffffff 100%);
  --surface: rgba(255, 255, 255, 0.86);
  --surface-hover: rgba(248, 250, 253, 0.96);
  --surface-solid: #ffffff;
  --border: rgba(60, 64, 67, 0.16);
  --border-focus: rgba(66, 133, 244, 0.55);
  --accent: var(--google-blue);
  --accent-glow: rgba(66, 133, 244, 0.22);
  --accent-purple: var(--google-red);
  --accent-purple-glow: rgba(234, 67, 53, 0.16);
  --cyan: var(--google-blue);
  --cyan-glow: rgba(66, 133, 244, 0.18);
  --emerald: var(--google-green);
  --emerald-glow: rgba(52, 168, 83, 0.18);
  --amber: var(--google-yellow);
  --rose: var(--google-red);
  --rose-glow: rgba(234, 67, 53, 0.2);
  --text: #202124;
  --text-muted: #5f6368;
  --text-dark: #80868b;
}

body.theme-dark {
  --bg: #000000;
  --bg-gradient: linear-gradient(180deg, #000000 0%, #000000 100%);
  --surface: rgba(0, 0, 0, 0.88);
  --surface-hover: rgba(8, 8, 8, 0.96);
  --surface-solid: #000000;
  --border: rgba(255, 255, 255, 0.12);
  --text: #f8fafc;
  --text-muted: #a1a1aa;
  --text-dark: #71717a;
}

/* ── Global Reset & Layout ─────────────────────────────────────────────── */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: 'Outfit', sans-serif;
  background: var(--bg);
  background-image: var(--bg-gradient);
  color: var(--text);
  min-height: 100vh;
  overflow-x: hidden;
  line-height: 1.5;
}

body::before {
  content: "";
  position: fixed;
  inset: 0 0 auto;
  height: 4px;
  z-index: 1100;
  background: linear-gradient(90deg, var(--google-blue) 0 25%, var(--google-red) 25% 50%, var(--google-yellow) 50% 75%, var(--google-green) 75% 100%);
  pointer-events: none;
}

.interview-theme-toggle {
  position: fixed;
  top: 16px;
  right: 18px;
  z-index: 1090;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  min-height: 38px;
  padding: 0 14px;
  border: 1px solid var(--border);
  border-radius: 999px;
  background: var(--surface);
  color: var(--text);
  box-shadow: 0 10px 30px rgba(0,0,0,0.18);
  cursor: pointer;
  font: inherit;
  font-weight: 700;
  backdrop-filter: blur(16px);
}
.interview-theme-toggle:hover {
  border-color: var(--accent);
  color: var(--accent);
}
.interview-theme-toggle .theme-icon {
  width: 23px;
  height: 23px;
  display: inline-grid;
  place-items: center;
  border-radius: 50%;
  background: conic-gradient(var(--google-blue), var(--google-green), var(--google-yellow), var(--google-red), var(--google-blue));
  color: #fff;
  font-size: 0.72rem;
  font-weight: 800;
}
.interview-theme-toggle .theme-label {
  font-size: 0.8rem;
}

body.theme-light .glass-panel {
  box-shadow: 0 1px 2px rgba(60,64,67,0.10), 0 12px 28px rgba(60,64,67,0.08),
              inset 0 1px 0 rgba(255,255,255,0.82);
}

/* Premium Custom Scrollbars */
::-webkit-scrollbar {
  width: 8px;
}
::-webkit-scrollbar-track {
  background: rgba(3, 3, 8, 0.5);
}
::-webkit-scrollbar-thumb {
  background: rgba(99, 102, 241, 0.25);
  border-radius: 10px;
  border: 2px solid var(--bg);
}
::-webkit-scrollbar-thumb:hover {
  background: rgba(99, 102, 241, 0.5);
}

/* Page Control */
.page {
  display: none;
  min-height: 100vh;
  opacity: 0;
  transform: translateY(15px);
  transition: opacity 0.5s ease, transform 0.5s ease;
}
.page.active {
  display: block;
  opacity: 1;
  transform: translateY(0);
}

/* ── Typography & Gradients ────────────────────────────────────────────── */
h1, h2, h3, h4, h5 {
  font-family: 'Space Grotesk', sans-serif;
  letter-spacing: -0.02em;
}

.gradient-text {
  background: linear-gradient(135deg, var(--text) 20%, var(--accent) 60%, var(--cyan) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-size: 200% auto;
  animation: shineText 6s linear infinite;
}

.ketu-brand-text {
  background: none;
  color: #000000;
  -webkit-text-fill-color: #000000;
  animation: none;
}

.gradient-accent {
  background: linear-gradient(135deg, var(--accent), var(--accent-purple));
}

/* ── Global Glassmorphic Components ───────────────────────────────────── */
.glass-panel {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  backdrop-filter: blur(25px);
  -webkit-backdrop-filter: blur(25px);
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5), 
              inset 0 1px 0 rgba(255, 255, 255, 0.05);
  transition: var(--transition);
}
.glass-panel:hover {
  border-color: rgba(99, 102, 241, 0.25);
  box-shadow: 0 24px 60px rgba(99, 102, 241, 0.05), 0 20px 50px rgba(0, 0, 0, 0.6);
}

/* Stepper Indicator */
.stepper-container {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 12px;
  margin: 20px auto 40px auto;
  max-width: 600px;
  padding: 12px 24px;
  background: rgba(13, 17, 33, 0.4);
  border: 1px solid rgba(255, 255, 255, 0.03);
  border-radius: 50px;
  backdrop-filter: blur(10px);
}
.step-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.08);
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--text-muted);
  transition: var(--transition);
  position: relative;
}
.step-dot.active {
  background: linear-gradient(135deg, var(--accent), var(--accent-purple));
  border-color: var(--accent);
  color: #fff;
  box-shadow: 0 0 15px var(--accent-glow);
}
.step-dot.completed {
  background: var(--emerald);
  border-color: var(--emerald);
  color: #fff;
  box-shadow: 0 0 10px var(--emerald-glow);
}
.step-line {
  flex: 1;
  height: 2px;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 2px;
  transition: var(--transition);
}
.step-line.filled {
  background: linear-gradient(90deg, var(--accent), var(--emerald));
}

/* Form Inputs */
.form-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 20px;
}
.form-group label {
  font-size: 0.85rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--text-muted);
}
.form-control {
  background: rgba(5, 7, 15, 0.6);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 12px 18px;
  color: var(--text);
  font-family: inherit;
  font-size: 0.95rem;
  outline: none;
  transition: var(--transition);
}
.form-control:focus {
  border-color: var(--cyan);
  box-shadow: 0 0 0 3px var(--cyan-glow), inset 0 2px 4px rgba(0,0,0,0.5);
  background: rgba(5, 7, 15, 0.8);
}
.form-control::placeholder {
  color: var(--text-dark);
}

textarea.form-control {
  resize: vertical;
  min-height: 92px;
}

.schedule-status-panel {
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 14px 16px;
  margin-top: 6px;
  color: var(--text);
  background: rgba(6, 182, 212, 0.08);
}

.schedule-status-panel.hidden {
  display: none;
}

.mode-hidden {
  display: none !important;
}

/* Premium Buttons */
.btn-premium {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  background: linear-gradient(135deg, var(--accent), var(--accent-purple));
  color: #fff;
  border: none;
  border-radius: var(--radius-sm);
  padding: 14px 28px;
  font-size: 1rem;
  font-weight: 600;
  cursor: pointer;
  box-shadow: 0 8px 24px var(--accent-glow);
  transition: var(--transition);
  font-family: inherit;
}
.btn-premium:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 30px var(--accent-glow), 0 0 15px rgba(168, 85, 247, 0.5);
  filter: brightness(1.1);
}
.btn-premium:active {
  transform: translateY(0);
}
.btn-premium:disabled {
  background: rgba(255, 255, 255, 0.05);
  color: var(--text-dark);
  box-shadow: none;
  cursor: not-allowed;
  border: 1px solid rgba(255, 255, 255, 0.03);
}

.btn-secondary-premium {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--border);
  color: var(--text);
  border-radius: var(--radius-sm);
  padding: 12px 24px;
  font-size: 0.95rem;
  font-weight: 500;
  cursor: pointer;
  transition: var(--transition);
  font-family: inherit;
}
.btn-secondary-premium:hover {
  background: rgba(99, 102, 241, 0.08);
  border-color: rgba(99, 102, 241, 0.4);
}

/* ── Lobby Page (`#page-lobby`) ───────────────────────────────────────── */
.lobby-container {
  max-width: 1000px;
  margin: 0 auto;
  padding: 60px 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.lobby-header {
  margin-bottom: 40px;
}
.lobby-logo {
  font-size: 5rem;
  margin-bottom: 24px;
  filter: drop-shadow(0 0 30px rgba(99, 102, 241, 0.7));
  animation: floatAvatar 4s ease-in-out infinite;
}
.lobby-title {
  font-size: clamp(2.5rem, 6vw, 3.8rem);
  font-weight: 800;
  line-height: 1.1;
  margin-bottom: 12px;
}
.lobby-subtitle {
  font-size: 1.2rem;
  color: var(--text-muted);
  max-width: 600px;
  margin: 0 auto;
}
.lobby-stats {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 20px;
  width: 100%;
  margin: 40px 0;
}
.stat-card-premium {
  padding: 24px;
  text-align: left;
  border-radius: var(--radius-md);
  position: relative;
  overflow: hidden;
}
.stat-card-premium::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 4px;
  height: 100%;
  background: linear-gradient(to bottom, var(--accent), var(--cyan));
}
.stat-card-premium:nth-child(4n + 1)::before,
.report-score-gauge-card,
.question-panel-premium {
  border-top: 4px solid var(--google-blue);
}
.stat-card-premium:nth-child(4n + 2)::before,
.metadata-highlights-executive-panel {
  border-top: 4px solid var(--google-green);
}
.stat-card-premium:nth-child(4n + 3)::before,
.insight-pinnacle-card.strengths {
  border-top-color: var(--google-yellow);
}
.stat-card-premium:nth-child(4n + 4)::before,
.insight-pinnacle-card.improvements {
  border-top-color: var(--google-red);
}
.stat-icon-premium {
  font-size: 2rem;
  margin-bottom: 12px;
}
.stat-num {
  font-size: 1.8rem;
  font-weight: 700;
  font-family: 'Space Grotesk', sans-serif;
  margin-bottom: 4px;
}
.stat-desc {
  font-size: 0.88rem;
  color: var(--text-muted);
}

/* ── Registration Page (`#page-register`) ─────────────────────────────── */
.register-container {
  max-width: 800px;
  margin: 0 auto;
  padding: 40px 20px;
}
.form-card {
  padding: 40px;
}
.form-header {
  margin-bottom: 30px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  padding-bottom: 20px;
}
.form-header h2 {
  font-size: 1.8rem;
  font-weight: 700;
}
.form-header p {
  font-size: 0.95rem;
  color: var(--text-muted);
  margin-top: 4px;
}
.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}
@media (max-width: 600px) {
  .form-row {
    grid-template-columns: 1fr;
    gap: 0;
  }
}
.skills-tag-wrap {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.skills-input-field {
  position: relative;
}
.skills-pill-box {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 8px;
}
.skill-pill {
  font-size: 0.78rem;
  font-weight: 600;
  background: rgba(6, 182, 212, 0.1);
  border: 1px solid rgba(6, 182, 212, 0.25);
  color: var(--cyan);
  padding: 4px 10px;
  border-radius: 50px;
  display: flex;
  align-items: center;
  gap: 6px;
}
.skill-pill span {
  cursor: pointer;
  font-weight: bold;
}
.skill-pill span:hover {
  color: var(--rose);
}

/* ── System Calibration Page (`#page-calibration`) ─────────────────────── */
.calibration-container {
  max-width: 900px;
  margin: 0 auto;
  padding: 40px 20px;
}
.calibration-grid {
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 28px;
  margin-bottom: 30px;
}
@media (max-width: 768px) {
  .calibration-grid {
    grid-template-columns: 1fr;
  }
}
.webcam-calibration-card {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  align-items: center;
  justify-content: center;
}
.camera-view-wrapper {
  width: 100%;
  aspect-ratio: 16/9;
  background: rgba(3, 3, 8, 0.9);
  border-radius: var(--radius-md);
  position: relative;
  overflow: hidden;
  border: 1px solid rgba(255, 255, 255, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
}
.calibration-webcam {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.camera-overlay-frame {
  position: absolute;
  inset: 15px;
  border: 2px dashed rgba(6, 182, 212, 0.35);
  border-radius: var(--radius-sm);
  pointer-events: none;
  display: flex;
  align-items: center;
  justify-content: center;
}
.camera-overlay-frame::before {
  content: 'POSITION FACE HERE';
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  color: var(--cyan);
  background: rgba(3, 3, 8, 0.7);
  padding: 4px 10px;
  border-radius: 50px;
  border: 1px solid rgba(6, 182, 212, 0.2);
}
.camera-status-tag {
  position: absolute;
  top: 20px;
  left: 20px;
  font-size: 0.75rem;
  background: rgba(244, 63, 94, 0.85);
  border: 1px solid rgba(244, 63, 94, 0.3);
  padding: 4px 10px;
  border-radius: 4px;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 6px;
}
.camera-status-tag.active {
  background: rgba(16, 185, 129, 0.85);
  border-color: rgba(16, 185, 129, 0.3);
}
.tag-dot {
  width: 8px;
  height: 8px;
  background: #fff;
  border-radius: 50%;
  animation: pulseLight 1s infinite alternate;
}

.hardware-checklist-card {
  padding: 30px;
}
.checklist-title {
  font-size: 1.3rem;
  margin-bottom: 20px;
  border-bottom: 1px solid rgba(255,255,255,0.05);
  padding-bottom: 10px;
}
.checklist-item {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  padding: 16px 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.03);
}
.checklist-item:last-child {
  border-bottom: none;
}
.checklist-indicator {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.8rem;
  color: var(--text-dark);
  flex-shrink: 0;
  transition: var(--transition);
}
.checklist-item.pass .checklist-indicator {
  background: var(--emerald);
  border-color: var(--emerald);
  color: #fff;
  box-shadow: 0 0 10px var(--emerald-glow);
}
.checklist-details {
  flex: 1;
}
.checklist-details h4 {
  font-size: 0.95rem;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 2px;
}
.checklist-details p {
  font-size: 0.82rem;
  color: var(--text-muted);
}
.checklist-action-btn {
  margin-top: 8px;
  padding: 6px 12px;
  font-size: 0.78rem;
  font-weight: 600;
}

/* Audio volume monitor */
.volume-meter-wrapper {
  margin-top: 10px;
  background: rgba(5, 7, 15, 0.6);
  border: 1px solid var(--border);
  border-radius: 6px;
  height: 8px;
  overflow: hidden;
  position: relative;
}
.volume-meter-bar {
  height: 100%;
  width: 0%;
  background: linear-gradient(90deg, var(--emerald) 70%, var(--amber) 90%, var(--rose));
  border-radius: 6px;
  transition: width 0.1s ease;
}

/* ── Interview Cockpit Page (`#page-interview`) ───────────────────────── */
.interview-layout {
  display: grid;
  grid-template-columns: 360px 1fr;
  height: 100vh;
  background: var(--bg);
  position: relative;
}
@media (max-width: 1000px) {
  .interview-layout {
    grid-template-columns: 1fr;
    grid-template-rows: auto 1fr;
    height: auto;
  }
}

/* Panel Side: AI & Chat Console */
.interview-side-console {
  background: rgba(8, 10, 24, 0.9);
  border-right: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  height: 100%;
  overflow: hidden;
}
@media (max-width: 1000px) {
  .interview-side-console {
    height: auto;
    max-height: 450px;
  }
}
.ai-avatar-console-card {
  padding: 30px 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  background: rgba(13, 17, 33, 0.25);
  position: relative;
}
.ai-hologram-viewport {
  position: relative;
  width: 110px;
  height: 110px;
  margin-bottom: 16px;
}
.ai-hologram-avatar {
  font-size: 4.5rem;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(99, 102, 241, 0.2) 0%, rgba(6, 182, 212, 0.03) 70%);
  border: 2px solid rgba(99, 102, 241, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 2;
  animation: pulseGlowAvatar 3s infinite alternate;
}
.hologram-ring {
  position: absolute;
  inset: -8px;
  border: 1.5px solid rgba(6, 182, 212, 0.4);
  border-radius: 50%;
  border-top-color: transparent;
  border-bottom-color: transparent;
  animation: rotateHologram 4s linear infinite;
  z-index: 1;
}
.hologram-ring-inner {
  position: absolute;
  inset: -14px;
  border: 1px dashed rgba(168, 85, 247, 0.3);
  border-radius: 50%;
  animation: rotateHologramReverse 8s linear infinite;
  z-index: 1;
}
.ai-status-bubble {
  font-size: 0.78rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--cyan);
  background: rgba(6, 182, 212, 0.1);
  border: 1px solid rgba(6, 182, 212, 0.2);
  padding: 4px 14px;
  border-radius: 50px;
}
.ai-status-bubble.thinking {
  color: var(--amber);
  background: rgba(245, 158, 11, 0.1);
  border-color: rgba(245, 158, 11, 0.2);
}

/* Chat History Console */
.chat-console-window {
  flex: 1;
  overflow-y: auto;
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}
.chat-msg-bubble {
  max-width: 85%;
  padding: 12px 16px;
  border-radius: 16px;
  font-size: 0.88rem;
  line-height: 1.5;
  animation: messageSlideIn 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
}
.chat-msg-bubble.ai {
  background: rgba(13, 17, 33, 0.7);
  border: 1px solid rgba(99, 102, 241, 0.15);
  color: var(--text);
  align-self: flex-start;
  border-bottom-left-radius: 4px;
}
.chat-msg-bubble.candidate {
  background: rgba(16, 185, 129, 0.1);
  border: 1px solid rgba(16, 185, 129, 0.2);
  color: var(--text);
  align-self: flex-end;
  border-bottom-right-radius: 4px;
}
.chat-msg-bubble.critique {
  background: rgba(245, 158, 11, 0.08);
  border: 1px solid rgba(245, 158, 11, 0.15);
  color: var(--text-muted);
  align-self: center;
  text-align: center;
  max-width: 95%;
  font-size: 0.82rem;
  font-style: italic;
}

/* Panel Main: Interview Engine Cockpit */
.interview-main-cockpit {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
}
@media (max-width: 1000px) {
  .interview-main-cockpit {
    height: auto;
    min-height: 600px;
  }
}

/* Cockpit Header */
.cockpit-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 30px;
  background: rgba(5, 7, 15, 0.65);
  border-bottom: 1px solid var(--border);
  backdrop-filter: blur(10px);
  z-index: 10;
}
.cockpit-brand {
  font-family: 'Space Grotesk', sans-serif;
  font-weight: 700;
  font-size: 1.1rem;
  letter-spacing: 0.02em;
}
.candidate-badge-hdr {
  font-size: 0.8rem;
  color: var(--text-muted);
  background: rgba(255, 255, 255, 0.03);
  padding: 4px 10px;
  border-radius: 6px;
  border: 1px solid rgba(255, 255, 255, 0.05);
}
.cockpit-header-right {
  display: flex;
  align-items: center;
  gap: 24px;
}
.stepper-header-tracker {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4px;
}
.stepper-hdr-label {
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--text-muted);
  text-transform: uppercase;
}
.stepper-hdr-bar-bg {
  width: 140px;
  height: 5px;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 10px;
  overflow: hidden;
}
.stepper-hdr-bar-fill {
  height: 100%;
  width: 12.5%;
  background: linear-gradient(90deg, var(--accent), var(--cyan));
  border-radius: 10px;
  transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}
.cockpit-timer {
  font-size: 1.1rem;
  font-weight: 700;
  font-family: 'Space Grotesk', sans-serif;
  color: var(--cyan);
  background: rgba(6, 182, 212, 0.08);
  border: 1px solid rgba(6, 182, 212, 0.15);
  padding: 6px 14px;
  border-radius: var(--radius-sm);
  letter-spacing: 0.05em;
}

/* Cockpit Inner Workspace Grid */
.cockpit-workspace-grid {
  flex: 1;
  display: grid;
  grid-template-columns: 1fr 280px;
  height: calc(100% - 75px);
}
@media (max-width: 800px) {
  .cockpit-workspace-grid {
    grid-template-columns: 1fr;
  }
}

/* Primary Interview Screen Area */
.cockpit-primary-screen {
  padding: 30px;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 20px;
  background: rgba(3, 3, 8, 0.35);
}
.question-panel-premium {
  padding: 30px;
  position: relative;
  overflow: hidden;
}
.question-label-hdr {
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--accent);
  margin-bottom: 12px;
}
.question-text-field {
  font-size: 1.25rem;
  font-weight: 500;
  line-height: 1.6;
  margin-bottom: 20px;
}
.question-metadata-chips {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}
.meta-chip-premium {
  font-size: 0.75rem;
  font-weight: 600;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.08);
  padding: 4px 12px;
  border-radius: 50px;
}
.meta-chip-premium.category {
  color: var(--cyan);
  background: rgba(6, 182, 212, 0.05);
  border-color: rgba(6, 182, 212, 0.15);
}
.meta-chip-premium.difficulty {
  color: var(--accent-purple);
  background: rgba(168, 85, 247, 0.05);
  border-color: rgba(168, 85, 247, 0.15);
}

/* Response Console Section */
.response-console-card {
  flex: 1;
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 18px;
}
.speech-visualizer-console {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(5, 7, 15, 0.75);
  border: 1px solid var(--border);
  padding: 16px 24px;
  border-radius: var(--radius-md);
}
.speech-mic-btn-premium {
  width: 52px;
  height: 52px;
  border-radius: 50%;
  border: 1px solid var(--border);
  background: rgba(13, 17, 33, 0.9);
  color: var(--text);
  font-size: 1.2rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: var(--transition);
  outline: none;
}
.speech-mic-btn-premium:hover {
  border-color: var(--cyan);
  color: var(--cyan);
  box-shadow: 0 0 15px var(--cyan-glow);
  transform: scale(1.05);
}
.speech-mic-btn-premium.recording {
  background: rgba(244, 63, 94, 0.15);
  border-color: var(--rose);
  color: var(--rose);
  box-shadow: 0 0 20px var(--rose-glow);
  animation: pulseRecordingMic 1.2s infinite;
}
.speech-status-bar {
  flex: 1;
  margin-left: 20px;
}
.speech-status-text {
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--text-muted);
}
.speech-live-hearing {
  font-size: 0.78rem;
  font-style: italic;
  color: var(--cyan);
  margin-top: 2px;
  display: block;
}

/* Audio wave canvas animation */
.canvas-audio-wave {
  width: 100px;
  height: 36px;
  background: transparent;
}

.editor-textarea-premium {
  width: 100%;
  background: rgba(5, 7, 15, 0.75);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 20px;
  color: var(--text);
  font-family: inherit;
  font-size: 1rem;
  line-height: 1.6;
  resize: none;
  flex: 1;
  min-height: 150px;
  outline: none;
  transition: var(--transition);
}
.editor-textarea-premium:focus {
  border-color: var(--accent);
  box-shadow: 0 0 20px var(--accent-glow);
}

.response-actions-wrap {
  display: flex;
  justify-content: flex-end;
  gap: 12px;
}

/* Live Evaluation Feedback Overlay inside workspace */
.active-evaluation-feedback-panel {
  background: rgba(13, 17, 33, 0.95);
  border: 1px solid rgba(245, 158, 11, 0.3);
  border-radius: var(--radius-md);
  padding: 20px;
  box-shadow: 0 10px 30px rgba(0,0,0,0.5);
  animation: messageSlideIn 0.4s ease;
}
.eval-hdr-wrap {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}
.eval-hdr-title {
  font-size: 0.95rem;
  font-weight: 700;
  color: var(--amber);
}
.eval-score-badge {
  font-size: 0.85rem;
  font-weight: 700;
  padding: 3px 10px;
  border-radius: 4px;
}
.eval-score-badge.high {
  background: rgba(16, 185, 129, 0.15);
  color: var(--emerald);
}
.eval-score-badge.mid {
  background: rgba(245, 158, 11, 0.15);
  color: var(--amber);
}
.eval-score-badge.low {
  background: rgba(244, 63, 94, 0.15);
  color: var(--rose);
}
.eval-desc-text {
  font-size: 0.88rem;
  color: var(--text-muted);
  line-height: 1.5;
}

/* Side Column: Telemetry & Monitoring (Webcam mirror & proctoring stats) */
.cockpit-telemetry-sidebar {
  background: rgba(5, 7, 15, 0.4);
  border-left: 1px solid var(--border);
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 20px;
  overflow-y: auto;
}
@media (max-width: 800px) {
  .cockpit-telemetry-sidebar {
    border-left: none;
    border-top: 1px solid var(--border);
  }
}
.telemetry-header-title {
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--text-muted);
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  padding-bottom: 8px;
}
.candidate-mirror-camera-panel {
  width: 100%;
  aspect-ratio: 4/3;
  background: #000;
  border-radius: var(--radius-md);
  border: 1px solid var(--border);
  position: relative;
  overflow: hidden;
}
.candidate-live-webcam-feed {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.webcam-overlay-indicator-wrap {
  position: absolute;
  top: 12px;
  left: 12px;
  background: rgba(3, 3, 8, 0.65);
  padding: 4px 10px;
  border-radius: 50px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  font-size: 0.65rem;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 6px;
}
.webcam-overlay-indicator-wrap::before {
  content: '';
  width: 6px;
  height: 6px;
  background: var(--emerald);
  border-radius: 50%;
  box-shadow: 0 0 6px var(--emerald);
}

.integrity-telemetry-monitor-card {
  padding: 20px;
}
.trust-index-visualizer {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-bottom: 16px;
}
.trust-dial-ring-wrap {
  position: relative;
  width: 54px;
  height: 54px;
  flex-shrink: 0;
}
.trust-radial-ring {
  width: 100%;
  height: 100%;
  transform: rotate(-90deg);
}
.trust-score-digital {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.9rem;
  font-weight: 700;
  font-family: 'Space Grotesk', sans-serif;
}
.trust-meta-description h5 {
  font-size: 0.85rem;
  color: var(--text-muted);
  font-weight: 500;
}
.trust-meta-description p {
  font-size: 1.15rem;
  font-weight: 700;
  color: var(--emerald);
}

.proctoring-telemetry-checklist {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.telemetry-row-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.78rem;
  padding: 6px 0;
  border-bottom: 1px solid rgba(255,255,255,0.03);
}
.telemetry-row-item:last-child {
  border-bottom: none;
}
.telemetry-row-item span {
  color: var(--text-muted);
}
.telemetry-row-item b {
  color: var(--emerald);
  display: flex;
  align-items: center;
  gap: 5px;
}
.telemetry-row-item b.alerting {
  color: var(--rose);
}

/* ── AI Evaluation Engine Loader Page (`#page-loading`) ───────────────── */
.loading-engine-container {
  max-width: 600px;
  margin: 0 auto;
  padding: 80px 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.loading-portal-viewport {
  position: relative;
  width: 180px;
  height: 180px;
  margin-bottom: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.loading-portal-ring-outer {
  position: absolute;
  inset: 0;
  border: 4px solid rgba(99, 102, 241, 0.05);
  border-top: 4px solid var(--accent);
  border-bottom: 4px solid var(--accent-purple);
  border-radius: 50%;
  animation: rotatePortal 1.5s cubic-bezier(0.53, 0.21, 0.29, 0.67) infinite;
}
.loading-portal-ring-inner {
  position: absolute;
  inset: 15px;
  border: 2px dashed rgba(6, 182, 212, 0.25);
  border-left-color: var(--cyan);
  border-radius: 50%;
  animation: rotatePortalReverse 3s linear infinite;
}
.loading-portal-core {
  font-size: 3.5rem;
  animation: floatAvatar 2s ease-in-out infinite alternate;
}
.loading-analysis-title {
  font-size: 2.2rem;
  font-weight: 700;
  margin-bottom: 12px;
}
.loading-analysis-desc {
  font-size: 1.05rem;
  color: var(--text-muted);
  max-width: 480px;
  margin: 0 auto 30px auto;
}

/* Custom visual list for assessment progression */
.loading-stage-process-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
  width: 100%;
  max-width: 400px;
  text-align: left;
}
.loading-stage-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 16px;
  border-radius: var(--radius-sm);
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid rgba(255, 255, 255, 0.04);
  font-size: 0.85rem;
  color: var(--text-muted);
  transition: var(--transition);
}
.loading-stage-item.active {
  background: rgba(99, 102, 241, 0.06);
  border-color: rgba(99, 102, 241, 0.2);
  color: var(--text);
  box-shadow: 0 4px 15px rgba(99, 102, 241, 0.03);
}
.loading-stage-item.completed {
  color: var(--emerald);
}
.loading-stage-bullet {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.2);
  flex-shrink: 0;
  transition: var(--transition);
}
.loading-stage-item.active .loading-stage-bullet {
  background: var(--cyan);
  border-color: var(--cyan);
  box-shadow: 0 0 8px var(--cyan);
  animation: pulseLight 0.8s infinite alternate;
}
.loading-stage-item.completed .loading-stage-bullet {
  background: var(--emerald);
  border-color: var(--emerald);
}

/* ── Executive Report Page (`#page-report`) ───────────────────────────── */
.report-layout-container {
  max-width: 1050px;
  margin: 0 auto;
  padding: 50px 20px;
}
.report-hero-header-card {
  padding: 40px;
  margin-bottom: 30px;
  text-align: center;
  position: relative;
  overflow: hidden;
}
.report-badge-status-top {
  font-size: 0.8rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--emerald);
  background: rgba(16, 185, 129, 0.1);
  border: 1px solid rgba(16, 185, 129, 0.25);
  padding: 6px 18px;
  border-radius: 50px;
  display: inline-block;
  margin-bottom: 20px;
}
.report-executive-title {
  font-size: 2.8rem;
  font-weight: 800;
  margin-bottom: 8px;
}
.report-executive-subtitle {
  font-size: 1.15rem;
  color: var(--text-muted);
}

/* Detailed Score Dial Section */
.report-dashboard-highlights-grid {
  display: grid;
  grid-template-columns: 1fr 1.3fr;
  gap: 30px;
  margin-bottom: 35px;
}
@media (max-width: 768px) {
  .report-dashboard-highlights-grid {
    grid-template-columns: 1fr;
  }
}

.report-score-gauge-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40px;
}
.radial-score-gauge-wrap {
  position: relative;
  width: 170px;
  height: 170px;
  margin-bottom: 24px;
}
.radial-score-ring-svg {
  width: 100%;
  height: 100%;
  transform: rotate(-90deg);
}
.radial-ring-background-track {
  fill: none;
  stroke: rgba(255, 255, 255, 0.03);
  stroke-width: 12;
}
.radial-ring-active-indicator {
  fill: none;
  stroke: url(#activeScoreGrad);
  stroke-width: 12;
  stroke-linecap: round;
  stroke-dasharray: 377; /* 2 * PI * r (r=60 -> 376.99) */
  stroke-dashoffset: 377;
  transition: stroke-dashoffset 1.8s cubic-bezier(0.2, 0.8, 0.2, 1);
}
.score-digital-readout {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.score-digital-readout .huge-digit {
  font-size: 3.4rem;
  font-weight: 800;
  font-family: 'Space Grotesk', sans-serif;
  line-height: 1;
}
.score-digital-readout .score-ceiling {
  font-size: 0.85rem;
  color: var(--text-muted);
  font-weight: 500;
  margin-top: 2px;
}
.score-level-recommendation-tag {
  font-size: 1rem;
  font-weight: 700;
  letter-spacing: 0.02em;
  padding: 8px 24px;
  border-radius: var(--radius-sm);
  text-align: center;
  width: 100%;
  max-width: 240px;
  box-shadow: 0 4px 15px rgba(0,0,0,0.25);
}
.rec-high-praise {
  background: rgba(16, 185, 129, 0.12);
  border: 1px solid rgba(16, 185, 129, 0.35);
  color: var(--emerald);
}
.rec-mid-average {
  background: rgba(245, 158, 11, 0.12);
  border: 1px solid rgba(245, 158, 11, 0.35);
  color: var(--amber);
}
.rec-low-retrain {
  background: rgba(244, 63, 94, 0.12);
  border: 1px solid rgba(244, 63, 94, 0.35);
  color: var(--rose);
}

.metadata-highlights-executive-panel {
  padding: 35px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 16px;
}
.highlights-bullet-item {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 10px 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.04);
}
.highlights-bullet-item:last-child {
  border-bottom: none;
}
.highlight-bullet-badge {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  background: rgba(99, 102, 241, 0.08);
  border: 1px solid rgba(99, 102, 241, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.25rem;
  flex-shrink: 0;
}
.highlights-bullet-item:nth-child(1) .highlight-bullet-badge {
  background: color-mix(in srgb, var(--google-blue) 14%, transparent);
  border-color: color-mix(in srgb, var(--google-blue) 30%, transparent);
}
.highlights-bullet-item:nth-child(2) .highlight-bullet-badge {
  background: color-mix(in srgb, var(--google-red) 12%, transparent);
  border-color: color-mix(in srgb, var(--google-red) 28%, transparent);
}
.highlights-bullet-item:nth-child(3) .highlight-bullet-badge {
  background: color-mix(in srgb, var(--google-yellow) 18%, transparent);
  border-color: color-mix(in srgb, var(--google-yellow) 36%, transparent);
}
.highlights-bullet-details h4 {
  font-size: 0.85rem;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: 2px;
}
.highlights-bullet-details p {
  font-size: 1.05rem;
  font-weight: 600;
}

/* Strengths & Improvements Layout */
.insights-executive-double-column {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  margin-bottom: 35px;
}
@media (max-width: 768px) {
  .insights-executive-double-column {
    grid-template-columns: 1fr;
  }
}
.insight-pinnacle-card {
  padding: 30px;
}
.insight-pinnacle-card.strengths {
  border-top: 4px solid var(--emerald);
}
.insight-pinnacle-card.improvements {
  border-top: 4px solid var(--accent-purple);
}
.insight-pinnacle-card h3 {
  font-size: 1.2rem;
  font-weight: 700;
  margin-bottom: 20px;
  display: flex;
  align-items: center;
  gap: 10px;
}
.insight-list-item-bullet {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.insight-list-item-bullet li {
  font-size: 0.92rem;
  color: var(--text-muted);
  line-height: 1.55;
  padding-left: 20px;
  position: relative;
}
.insight-list-item-bullet li::before {
  content: '✦';
  position: absolute;
  left: 0;
  color: var(--cyan);
}

/* Report Tab Bar Control */
.report-dashboard-tab-bar {
  display: flex;
  background: rgba(13, 17, 33, 0.4);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 6px;
  margin-bottom: 24px;
}
.report-dashboard-tab-btn {
  flex: 1;
  text-align: center;
  padding: 12px;
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--text-muted);
  background: transparent;
  border: none;
  cursor: pointer;
  border-radius: 8px;
  transition: var(--transition);
  font-family: inherit;
}
.report-dashboard-tab-btn:hover {
  color: var(--text);
}
.report-dashboard-tab-btn.active {
  background: var(--google-blue);
  color: #fff;
  box-shadow: 0 4px 15px var(--accent-glow);
}

/* Tab Panels Content */
.report-tab-panel-viewport {
  margin-bottom: 35px;
}
.report-tab-panel-content {
  display: none;
  animation: messageSlideIn 0.4s ease;
}
.report-tab-panel-content.active {
  display: block;
}

/* Detailed Question Timeline */
.qa-timeline-block {
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.qa-timeline-card-item {
  padding: 24px;
}
.timeline-card-header-premium {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  padding-bottom: 12px;
  margin-bottom: 16px;
}
.timeline-question-badge {
  font-size: 0.78rem;
  font-weight: 700;
  text-transform: uppercase;
  color: var(--text-muted);
}
.timeline-score-badge-right {
  font-size: 0.95rem;
  font-weight: 700;
}
.timeline-question-title-text {
  font-size: 1.05rem;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 10px;
}
.timeline-candidate-answer-block {
  font-size: 0.92rem;
  color: var(--text-muted);
  background: rgba(3, 3, 8, 0.35);
  border: 1px solid rgba(255, 255, 255, 0.02);
  padding: 14px 18px;
  border-radius: var(--radius-sm);
  margin-bottom: 14px;
  line-height: 1.6;
}
.timeline-evaluation-critique-box {
  font-size: 0.88rem;
  color: var(--text-muted);
  border-left: 2px solid var(--cyan);
  padding-left: 16px;
  line-height: 1.6;
  font-style: italic;
}

/* Proctoring Integrity Log List */
.integrity-event-timeline-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.88rem;
}
.integrity-event-timeline-table th {
  text-align: left;
  padding: 12px 16px;
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  color: var(--text-muted);
  border-bottom: 1px solid var(--border);
  letter-spacing: 0.05em;
}
.integrity-event-timeline-table td {
  padding: 14px 16px;
  border-bottom: 1px solid rgba(255,255,255,0.03);
  color: var(--text-muted);
}
.integrity-event-timeline-table tr:hover td {
  background: rgba(244, 63, 94, 0.02);
}
.badge-proctoring-status {
  padding: 3px 8px;
  border-radius: 4px;
  font-size: 0.75rem;
  font-weight: 600;
}
.badge-proctoring-status.flagged {
  background: rgba(244, 63, 94, 0.15);
  color: var(--rose);
  border: 1px solid rgba(244, 63, 94, 0.3);
}

.report-action-buttons-wrap {
  display: flex;
  gap: 16px;
  justify-content: center;
  flex-wrap: wrap;
}

/* ── Interactive Loading / Processing Screen ──────────────────────────── */
.loading-screen-global-overlay {
  position: fixed;
  inset: 0;
  background: rgba(3, 3, 8, 0.95);
  backdrop-filter: blur(15px);
  z-index: 1000;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24px;
}
.loading-screen-global-overlay.hidden {
  display: none;
}
.spinner-premium {
  width: 60px;
  height: 60px;
  border: 3px solid rgba(99, 102, 241, 0.1);
  border-top-color: var(--cyan);
  border-bottom-color: var(--accent-purple);
  border-radius: 50%;
  animation: rotatePortal 0.8s linear infinite;
}
.spinner-msg-text {
  font-size: 1.05rem;
  color: var(--text-muted);
}

/* ── Animations ───────────────────────────────────────────────────────────── */
@keyframes shineText {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}
@keyframes floatAvatar {
  0% { transform: translateY(0); }
  50% { transform: translateY(-8px); }
  100% { transform: translateY(0); }
}
@keyframes rotateHologram {
  to { transform: rotate(360deg); }
}
@keyframes rotateHologramReverse {
  to { transform: rotate(-360deg); }
}
@keyframes rotatePortal {
  to { transform: rotate(360deg); }
}
@keyframes rotatePortalReverse {
  to { transform: rotate(-360deg); }
}
@keyframes pulseGlowAvatar {
  0% { box-shadow: 0 0 15px rgba(99, 102, 241, 0.2); }
  100% { box-shadow: 0 0 25px rgba(99, 102, 241, 0.45), 0 0 10px rgba(6, 182, 212, 0.3); }
}
@keyframes pulseLight {
  0% { opacity: 0.65; }
  100% { opacity: 1; transform: scale(1.05); }
}
@keyframes pulseRecordingMic {
  0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(244, 63, 94, 0.4); }
  70% { transform: scale(1.04); box-shadow: 0 0 0 12px rgba(244, 63, 94, 0); }
  100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(244, 63, 94, 0); }
}
@keyframes messageSlideIn {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

